{
  "name": "@ocarignan/metamorphosis",
  "version": "0.1.1",
  "description": "Morphing animation library — morphing text, line-drawn icons, and per-character font-outline glyphs. Framework-agnostic core + React adapters (text/icon are dependency-free; glyph morphing uses fontkit).",
  "license": "MIT",
  "author": "Olivier Carignan",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./icon-morph": {
      "types": "./dist/icon-morph/index.d.ts",
      "import": "./dist/icon-morph/index.mjs",
      "require": "./dist/icon-morph/index.js"
    },
    "./glyph-morph": {
      "types": "./dist/glyph-morph/index.d.ts",
      "import": "./dist/glyph-morph/index.mjs",
      "require": "./dist/glyph-morph/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "animation",
    "morph",
    "morphing",
    "text-morph",
    "icon-morph",
    "icon-morphing",
    "glyph-morph",
    "glyph-morphing",
    "letter",
    "font",
    "text",
    "icon",
    "svg",
    "spring",
    "transition"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "tsup"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/react": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olicarignan/metamorphosis.git"
  },
  "dependencies": {
    "fontkit": "^2.0.4"
  }
}
